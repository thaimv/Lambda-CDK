# Local synth/diff only — deploy via GitHub CD (push develop/staging).
# Copy: cp .env.example .env

# Max 10 chars (validated in load.config.ts)
CDK_PROJECT_ID=acme
CDK_ENV=dev
AWS_REGION=us-east-1

# Required when storage.enabled (S3 bucket name includes account ID)
AWS_ACCOUNT_ID=123456789012

# RDS stop/start schedule (dev only) — set RDS_SCHEDULE_ENABLED=false then cdk deploy to remove
RDS_SCHEDULE_ENABLED=true
RDS_SCHEDULE_TIMEZONE=Asia/Ho_Chi_Minh
RDS_SCHEDULE_STOP_CRON=0 20 * * ? *
RDS_SCHEDULE_START_CRON=0 8 * * ? *
