# CDK — GitHub Environment deploy config (template)
#
# Do not commit this file with real values. Copy this checklist to GitHub:
#   Settings → Environments → cdk-develop | cdk-staging
#
# Workflow: .github/workflows/cd.yml
#   push develop → cdk-develop (CDK_ENV=dev)
#   push staging → cdk-staging  (CDK_ENV=stg)
#
# ── Secret → GitHub Environment **Secrets** (not Variables) ────────────────
AWS_ROLE_TO_ASSUME=arn:aws:iam::194130476852:role/REPLACE_ME-github-oidc-cdk
#
# ── Vars → GitHub Environment **Variables** ────────────────────────────────
CDK_PROJECT_ID=thaimv
AWS_ACCOUNT_ID=194130476852
AWS_REGION=ap-northeast-1
#
# ── cdk-develop only — RDS stop/start schedule (optional) ──────────────────
# Set on GitHub Environment cdk-develop. Ignored on cdk-staging (CDK_ENV=stg).
# Set RDS_SCHEDULE_ENABLED=false (or omit) then redeploy to remove schedules.
RDS_SCHEDULE_ENABLED=true
RDS_SCHEDULE_TIMEZONE=Asia/Ho_Chi_Minh
RDS_SCHEDULE_STOP_CRON=0 20 * * ? *
RDS_SCHEDULE_START_CRON=0 8 * * ? *
#
# ── Local synth/diff only (not used by GitHub CD) ──────────────────────────
# CDK_ENV=dev
#
# ── After cdk deploy — copy stack outputs to child repos ───────────────────
#
# LambdaAPIs (Environment: api-develop / api-staging)
#   LAMBDA_FUNCTION_PUBLIC_API_NAME     → output PublicApiFnName
#   LAMBDA_FUNCTION_AUTH_API_NAME       → output AuthApiFnName
#   LAMBDA_FUNCTION_APPSYNC_NAME        → output AppsyncApiFnName
#   APPSYNC_API_ID                      → output AppsyncApiId
#   PRISMA_LAYER_NAME                   → output PrismaLayerName
#   LAMBDA_ALIAS_NAME                   → output LambdaAliasName (live)
#
# LambdaEvents (Environment: event-develop / event-staging)
#   LAMBDA_FUNCTION_JWT_AUTHORIZER_NAME → output JwtAuthorizerFnName
#   LAMBDA_FUNCTION_DELETE_USER_NAME    → output DeleteUserFnName
#   STEP_FUNCTION_DELETE_USER_BATCH_NAME → output DeleteUserBatchSfnName
#   PRISMA_LAYER_NAME                   → output PrismaLayerName
#   ELASTICACHE_LAYER_NAME              → output ElastiCacheLayerName
#   LAMBDA_ALIAS_NAME                   → output LambdaAliasName (live)
#
# Example resource names (CDK_PROJECT_ID=thaimv, CDK_ENV=dev):
#   thaimv-dev-public-api-function
#   thaimv-dev-auth-api-function
#   thaimv-dev-appsync-api-function
#   thaimv-dev-jwt-authorizer-function
#   thaimv-dev-delete-user-function
#   thaimv-dev-delete-user-batch-sfn
#   thaimv-dev-prisma-layer
#   thaimv-dev-elasticache-layer
